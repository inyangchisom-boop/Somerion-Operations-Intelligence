rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validOrder(data) {
      return data.keys().hasAll([
          'reference', 'customer', 'total', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'reference', 'customer', 'total', 'status', 'currency', 'createdAt', 'updatedAt'
        ])
        && (!('currency' in data) || (
          data.currency is string
          && data.currency.matches('^[A-Z]{3}$')
        ))
        && data.reference is string
        && data.reference.size() > 0
        && data.reference.size() <= 60
        && data.customer is string
        && data.customer.size() > 0
        && data.customer.size() <= 100
        && data.total is number
        && data.total >= 0
        && data.status in ['Pending', 'Processing', 'Shipped', 'Completed', 'Cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validProduct(data) {
      return data.keys().hasAll([
          'name', 'sku', 'quantity', 'reorderLevel', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'sku', 'quantity', 'reorderLevel', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.sku is string
        && data.sku.size() <= 60
        && data.quantity is int
        && data.quantity >= 0
        && data.reorderLevel is int
        && data.reorderLevel >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }


    function validBusinessProfile(data) {
      return data.keys().hasAll([
          'businessName', 'industry', 'businessSize', 'country', 'baseCurrency', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'businessName', 'industry', 'businessSize', 'country', 'baseCurrency', 'createdAt', 'updatedAt'
        ])
        && data.businessName is string
        && data.businessName.size() > 0
        && data.businessName.size() <= 100
        && data.industry in [
          'commerce', 'retail', 'professional-services', 'agency', 'hospitality',
          'health-wellness', 'construction-trades', 'education', 'logistics',
          'manufacturing', 'nonprofit-public', 'other'
        ]
        && data.businessSize in ['solo', 'small', 'medium', 'large', 'nonprofit']
        && data.country is string
        && data.country.size() > 0
        && data.country.size() <= 80
        && data.baseCurrency is string
        && data.baseCurrency.matches('^[A-Z]{3}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/settings/{settingId} {
      allow read: if owns(userId) && settingId == 'businessProfile';
      allow create: if owns(userId)
        && settingId == 'businessProfile'
        && validBusinessProfile(request.resource.data);
      allow update: if owns(userId)
        && settingId == 'businessProfile'
        && validBusinessProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /users/{userId}/orders/{recordId} {
      allow read, delete: if owns(userId);
      allow create: if owns(userId) && validOrder(request.resource.data);
      allow update: if owns(userId)
        && validOrder(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{userId}/products/{recordId} {
      allow read, delete: if owns(userId);
      allow create: if owns(userId) && validProduct(request.resource.data);
      allow update: if owns(userId)
        && validProduct(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}