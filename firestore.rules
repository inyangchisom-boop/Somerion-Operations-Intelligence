rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.uid == 'MnTpG1cRJETCZMs8fbg6tDMkRvA2'; }
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validOrder(data) {
      return data.keys().hasAll(['reference','customer','total','status','createdAt','updatedAt'])
        && data.keys().hasOnly(['reference','customer','total','status','currency','createdAt','updatedAt'])
        && (!('currency' in data) || (data.currency is string && data.currency.matches('^[A-Z]{3}$')))
        && data.reference is string && data.reference.size() > 0 && data.reference.size() <= 60
        && data.customer is string && data.customer.size() > 0 && data.customer.size() <= 100
        && data.total is number && data.total >= 0
        && data.status in ['Pending','Processing','Shipped','Completed','Cancelled']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validProduct(data) {
      return data.keys().hasAll(['name','sku','quantity','reorderLevel','createdAt','updatedAt'])
        && data.keys().hasOnly(['name','sku','quantity','reorderLevel','createdAt','updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.sku is string && data.sku.size() <= 60
        && data.quantity is int && data.quantity >= 0
        && data.reorderLevel is int && data.reorderLevel >= 0
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validBusinessProfile(data) {
      return data.keys().hasAll(['businessName','industry','businessSize','country','baseCurrency','createdAt','updatedAt'])
        && data.keys().hasOnly(['businessName','industry','businessSize','country','baseCurrency','createdAt','updatedAt'])
        && data.businessName is string && data.businessName.size() > 0 && data.businessName.size() <= 100
        && data.industry in ['commerce','retail','professional-services','agency','hospitality','health-wellness','construction-trades','education','logistics','manufacturing','nonprofit-public','other']
        && data.businessSize in ['solo','small','medium','large','nonprofit']
        && data.country is string && data.country.size() > 0 && data.country.size() <= 80
        && data.baseCurrency is string && data.baseCurrency.matches('^[A-Z]{3}$')
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validCustomer(data) {
      return data.keys().hasAll(['name','company','email','phone','stage','notes','createdAt','updatedAt'])
        && data.keys().hasOnly(['name','company','email','phone','stage','notes','createdAt','updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.company is string && data.company.size() <= 120
        && data.email is string && data.email.size() <= 160
        && data.phone is string && data.phone.size() <= 40
        && data.stage in ['lead','prospect','customer','inactive']
        && data.notes is string && data.notes.size() <= 2000
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validProject(data) {
      return data.keys().hasAll(['name','client','status','startDate','dueDate','description','createdAt','updatedAt'])
        && data.keys().hasOnly(['name','client','status','startDate','dueDate','description','createdAt','updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && data.client is string && data.client.size() > 0 && data.client.size() <= 120
        && data.status in ['planned','active','on-hold','completed','cancelled']
        && data.startDate is string && data.startDate.size() <= 10
        && data.dueDate is string && data.dueDate.size() <= 10
        && data.description is string && data.description.size() <= 2000
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validTask(data) {
      return data.keys().hasAll(['title','projectId','projectName','assignee','status','dueDate','details','createdAt','updatedAt'])
        && data.keys().hasOnly(['title','projectId','projectName','assignee','status','dueDate','details','createdAt','updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.projectId is string && data.projectId.size() <= 128
        && data.projectName is string && data.projectName.size() <= 160
        && data.assignee is string && data.assignee.size() <= 120
        && data.status in ['todo','in-progress','blocked','done']
        && data.dueDate is string && data.dueDate.size() <= 10
        && data.details is string && data.details.size() <= 2000
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validServiceJob(data) {
      return data.keys().hasAll(['title','customer','serviceType','status','scheduledAt','location','notes','createdAt','updatedAt'])
        && data.keys().hasOnly(['title','customer','serviceType','status','scheduledAt','location','notes','createdAt','updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.customer is string && data.customer.size() > 0 && data.customer.size() <= 120
        && data.serviceType is string && data.serviceType.size() > 0 && data.serviceType.size() <= 100
        && data.status in ['requested','scheduled','in-progress','completed','cancelled']
        && data.scheduledAt is string && data.scheduledAt.size() <= 30
        && data.location is string && data.location.size() <= 200
        && data.notes is string && data.notes.size() <= 2000
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validFinanceEntry(data) {
      return data.keys().hasAll(['type','description','category','amount','currency','entryDate','reference','createdAt','updatedAt'])
        && data.keys().hasOnly(['type','description','category','amount','currency','entryDate','reference','createdAt','updatedAt'])
        && data.type in ['income','expense']
        && data.description is string && data.description.size() > 0 && data.description.size() <= 160
        && data.category is string && data.category.size() > 0 && data.category.size() <= 80
        && data.amount is number && data.amount > 0
        && data.currency is string && data.currency.matches('^[A-Z]{3}$')
        && data.entryDate is string && data.entryDate.size() == 10
        && data.reference is string && data.reference.size() <= 100
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /users/{userId}/settings/{settingId} {
      allow read: if owns(userId) && settingId == 'businessProfile';
      allow create: if owns(userId) && settingId == 'businessProfile' && validBusinessProfile(request.resource.data);
      allow update: if owns(userId) && settingId == 'businessProfile' && validBusinessProfile(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /users/{userId}/customers/{recordId} {
      allow read, delete: if owns(userId);
      allow create: if owns(userId) && validCustomer(request.resource.data);
      allow update: if owns(userId) && validCustomer(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /users/{userId}/projects/{recordId} {
      allow read, delete: if owns(userId);
      allow create: if owns(userId) && validProject(request.resource.data);
      allow update: if owns(userId) && validProject(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /users/{userId}/tasks/{recordId} {
      allow read, delete: if owns(userId);
      allow create: if owns(userId) && validTask(request.resource.data);
      allow update: if owns(userId) && validTask(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /users/{userId}/serviceJobs/{recordId} {
      allow read, delete: if owns(userId);
      allow create: if owns(userId) && validServiceJob(request.resource.data);
      allow update: if owns(userId) && validServiceJob(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /users/{userId}/finance/{recordId} {
      allow read, delete: if owns(userId);
      allow create: if owns(userId) && validFinanceEntry(request.resource.data);
      allow update: if owns(userId) && validFinanceEntry(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /users/{userId}/orders/{recordId} {
      allow read, delete: if owns(userId);
      allow create: if owns(userId) && validOrder(request.resource.data);
      allow update: if owns(userId) && validOrder(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /users/{userId}/products/{recordId} {
      allow read, delete: if owns(userId);
      allow create: if owns(userId) && validProduct(request.resource.data);
      allow update: if owns(userId) && validProduct(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid','rating','category','message','status','published','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['uid','rating','category','message','status','published','createdAt','updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.category in ['Design and appearance','Ease of use','Performance and reliability','Features and tools','Accessibility','Other']
        && request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'pending' && request.resource.data.published == false
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;
      allow read: if isOwner()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || resource.data.published == true;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['published','status','publishedAt','updatedAt'])
        && request.resource.data.published is bool
        && request.resource.data.updatedAt is timestamp
        && ((request.resource.data.published == true
             && request.resource.data.status == 'published'
             && request.resource.data.publishedAt is timestamp)
            || (request.resource.data.published == false
                && request.resource.data.status in ['pending','private','rejected']));
      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
